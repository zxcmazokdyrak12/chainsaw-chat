# copy to server/.env — never commit the real file

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# long random string: `openssl rand -hex 32`. Without it in production every restart logs everybody out.
JWT_SECRET=""
# optional, defaults to JWT_SECRET
SESSION_SECRET=""

CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:3001"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# TURN for video calls — pick one (see server/src/routes/ice.ts)
# Cloudflare Realtime TURN (free 1 TB/month)
CF_TURN_KEY_ID=""
CF_TURN_API_TOKEN=""
# or Metered.ca
METERED_DOMAIN=""
METERED_API_KEY=""
# or your own coturn (use-auth-secret)
TURN_URLS=""
TURN_SECRET=""
