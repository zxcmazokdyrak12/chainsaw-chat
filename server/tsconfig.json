{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // `npm run dev` only transpiles (fast, never blocked by a type error); `npm run typecheck` / CI check types
  "ts-node": { "esm": true, "transpileOnly": true }
}
