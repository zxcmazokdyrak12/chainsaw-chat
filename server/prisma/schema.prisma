generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LocalUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("local_users")
}

model ChatUser {
  id         Int      @id @default(autoincrement())
  provider   String
  providerId String   @map("provider_id")
  username   String
  avatar     String?
  email      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([provider, providerId])
  @@map("chat_users")
}

model Room {
  id        String   @id
  name      String
  code      String   @unique
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  members     RoomMember[]
  messages    Message[]
  readMarks   ReadMark[]
  attachments Attachment[]

  @@map("rooms")
}

model RoomMember {
  roomId   String   @map("room_id")
  username String
  joinedAt DateTime @default(now()) @map("joined_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, username])
  @@map("room_members")
}

model Message {
  id        BigInt   @id
  roomId    String   @map("room_id")
  username  String?
  content   String?
  type      String   @default("text")
  audioData String?  @map("audio_data")
  avatar    String?
  time      String?
  rotate    String?
  system    Boolean  @default(false)
  isEdited  Boolean  @default(false) @map("is_edited")
  isPinned  Boolean  @default(false) @map("is_pinned")
  // { "🔥": ["DENJI", "POWER"], ... }
  reactions Json     @default("{}")
  // picture / voice stored as an Attachment (old voice messages still use audioData)
  mediaId   String?  @map("media_id")
  // reply: the id we answer + a small snapshot, so the quote survives the original being deleted
  replyToId    BigInt? @map("reply_to_id")
  replyPreview Json?   @map("reply_preview")
  // contracts / polls: { kind, title, options: [{ id, label }], votes: { optionId: [username] }, closed }
  poll         Json?
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("messages")
}

// uploaded pictures and voice notes. Bytes live here (storage = "db") or in an R2 bucket (storage = "r2")
model Attachment {
  id        String   @id
  roomId    String   @map("room_id")
  username  String
  mime      String
  size      Int
  storage   String   @default("db")
  data      Bytes?
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// last message each user has seen in a room → powers SENT / SEEN flags
model ReadMark {
  roomId     String   @map("room_id")
  username   String
  lastReadId BigInt   @map("last_read_id")
  updatedAt  DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, username])
  @@map("read_marks")
}

// the "character page" a user fills in about themselves (volume-extras style)
model UserProfile {
  username   String   @id
  contract   String?
  likes      String?
  dislikes   String?
  dream      String?
  favChapter String?  @map("fav_chapter")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}
